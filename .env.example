# Copia este archivo como .env y completa los valores.

# Configuración de Base de Datos PostgreSQL con pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=petroff_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_contraseña
# POSTGRES_CONNECT_TIMEOUT_SEGUNDOS=3

# Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MAX_TOKENS=8000

# Embeddings (opcional, estos son los valores por defecto)
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# EMBEDDING_BATCH_SIZE=32

# Chunking (opcional)
# CHUNK_SIZE_PALABRAS=600

# Rutas de entrada/salida (opcional; por defecto data/ y salida/)
# INPUT_JSONL=data/Allard_500291.jsonl
# OUTPUT_CLEAN_JSONL=salida/pruebaocr_limpio.jsonl
# SQLITE_PATH=salida/vector_store_local.db

# SharePoint (Microsoft Graph) para validar los JSONL contra la carpeta del caso.
# Salen de la app registration en entra.microsoft.com > App registrations.
# Sin GRAPH_CLIENT_SECRET se entra como el usuario (abre el navegador la primera vez).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# SHAREPOINT_SITIO=amshenllp.sharepoint.com:/teams/Matters
# SHAREPOINT_CARPETA_CASOS=Matters
